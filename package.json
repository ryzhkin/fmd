{
  "name": "fantasy-map-demo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "build:e2e": "npm run typecheck && vite build --mode e2e",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:e2e": "npm run build:e2e && playwright test",
    "test": "npm run test:unit && npm run test:e2e",
    "check": "npm run data:verify -- --region=sumy && npm run lint && npm run test:unit && npm run test:e2e",
    "data:refresh": "tsx scripts/data/refresh-region.ts",
    "data:verify": "tsx scripts/data/verify-snapshot.ts",
    "lint": "eslint ."
  },
  "dependencies": {
    "maplibre-gl": "5.24.0"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@playwright/test": "1.55.0",
    "@types/geojson": "latest",
    "@types/node": "latest",
    "eslint": "latest",
    "globals": "latest",
    "jsdom": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "typescript-eslint": "latest",
    "vite": "latest",
    "vitest": "latest"
  }
}
